# Local development against the local Supabase stack (`make supabase-start`).
# `make setup` copies this file to .env. Values are seen from inside the app
# container, so the host is `host.docker.internal`.

# Supabase Auth. Get the key with `make supabase-status` (local defaults shown).
SUPABASE_URL=http://host.docker.internal:56321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Postgres. Runtime connection (pooler in Supabase Cloud) and direct connection for migrations.
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:56322/postgres
DIRECT_URL=postgresql://postgres:postgres@host.docker.internal:56322/postgres

# Separate database for integration tests (created automatically by the test setup).
TEST_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:56322/lucapp_test

# Public URL of the app, used to build email confirmation links.
APP_URL=http://localhost:3100

# Local Supabase secret key, only used by `make seed` to create the demo user.
# Copy the "Secret" key shown by `make supabase-status` (never commit a real one).
SUPABASE_SECRET_KEY=

# Web Push notifications (meal reminders, pantry alerts). Generate the pair with
# `make vapid`. Leave empty to turn notifications off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach (mailto: or https:). Apple rejects made-up domains.
VAPID_SUBJECT=
